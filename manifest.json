{
  "manifest_version": 3,
  "name": "Annotate",
  "version": "1.0",
  "description": "Powerful book annotation extension for EPUBs and PDFs.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_title": "Open Annotate Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["handwriting-fonts/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
